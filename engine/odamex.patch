diff --git a/client/sdl/i_frameexport.cpp b/client/sdl/i_frameexport.cpp
new file mode 100644
index 000000000..7419a8ae7
--- /dev/null
+++ b/client/sdl/i_frameexport.cpp
@@ -0,0 +1,230 @@
+// Exports each finished frame for the intermission Claude Code mod.
+//
+// When INTERMISSION_FRAMES names a shared-memory prefix (such as "/im"), every
+// frame is written as raw RGB into a fresh POSIX shared-memory object and its
+// name printed on stdout. The terminal reads the object and unlinks it, so no
+// pixel passes through the mod. Alongside go the moment the client reaches
+// the server, the player's score whenever it changes, and why, if the server
+// sends this client away. Without the variable this does nothing.
+//
+// Claude Code reads POSIX shared memory only, so on Windows the prefix starts
+// a file path instead, and each frame is a file the terminal reads and leaves
+// in place.
+
+#include "odamex.h"
+
+#include "i_frameexport.h"
+
+#include <cstdio>
+#include <cstdlib>
+
+#ifdef _WIN32
+#include <string>
+#include <vector>
+#include "win32inc.h"
+#else
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+#include "cl_main.h"
+#include "d_player.h"
+#include "i_inputfile.h"
+#include "i_video.h"
+
+// Once, so the mod can tell a slow connection from one that will never come
+static void reportConnected()
+{
+	static bool isReported = false;
+	if (isReported || !connected)
+		return;
+	isReported = true;
+	printf("@connected\n");
+}
+
+// Kills count monsters and players alike
+static void reportScore()
+{
+	static int kills = -1;
+	static int deaths = -1;
+	const player_t& player = consoleplayer();
+	const int nextKills = player.killcount + player.fragcount;
+	if (nextKills == kills && player.deathcount == deaths)
+		return;
+	kills = nextKills;
+	deaths = player.deathcount;
+	printf("@score %d %d\n", kills, deaths);
+}
+
+// A frame the terminal never read is never unlinked by it, so the oldest
+// leftovers are removed here once this many newer frames exist.
+static const unsigned FRAMES_IN_FLIGHT = 8;
+
+void I_ReportDisconnect(const char* reason)
+{
+	if (!getenv("INTERMISSION_FRAMES"))
+		return;
+	// One line, however the server worded it
+	printf("@disconnected ");
+	for (const char* c = reason; *c; c++)
+		if (*c != '\n')
+			putchar(*c);
+	putchar('\n');
+	fflush(stdout);
+}
+
+// Writes the surface's pixels as packed RGB
+static void packFrame(const IWindowSurface* surface, uint8_t* dest)
+{
+	const PixelFormat* format = surface->getPixelFormat();
+	const uint8_t rshift = format->getRShift();
+	const uint8_t gshift = format->getGShift();
+	const uint8_t bshift = format->getBShift();
+
+	for (int y = 0; y < surface->getHeight(); y++)
+	{
+		const uint32_t* row = (const uint32_t*)(surface->getBuffer() + y * surface->getPitch());
+		for (int x = 0; x < surface->getWidth(); x++)
+		{
+			const uint32_t pixel = row[x];
+			*dest++ = pixel >> rshift;
+			*dest++ = pixel >> gshift;
+			*dest++ = pixel >> bshift;
+		}
+	}
+}
+
+#ifdef _WIN32
+
+static const char* FRAME_SUFFIX = ".rgb";
+
+// The terminal leaves files in place, so frames an engine left when it was
+// killed stay until another engine starts and finds them stale
+static const ULONGLONG STALE_AFTER_MS = 60 * 1000;
+
+static std::string frameFolder(const char* prefix)
+{
+	const std::string path(prefix);
+	const size_t cut = path.find_last_of("\\/");
+	return cut == std::string::npos ? std::string(".") : path.substr(0, cut);
+}
+
+static void prepareFrames(const char* prefix)
+{
+	const std::string folder = frameFolder(prefix);
+	CreateDirectoryA(folder.c_str(), NULL);
+
+	FILETIME nowTime;
+	GetSystemTimeAsFileTime(&nowTime);
+	const ULONGLONG now = ((ULONGLONG)nowTime.dwHighDateTime << 32) | nowTime.dwLowDateTime;
+
+	WIN32_FIND_DATAA found;
+	const HANDLE search = FindFirstFileA((folder + "\\*" + FRAME_SUFFIX).c_str(), &found);
+	if (search == INVALID_HANDLE_VALUE)
+		return;
+	do
+	{
+		const FILETIME& written = found.ftLastWriteTime;
+		const ULONGLONG at = ((ULONGLONG)written.dwHighDateTime << 32) | written.dwLowDateTime;
+		// File times count 100-nanosecond steps
+		if (now > at && (now - at) / 10000 > STALE_AFTER_MS)
+			DeleteFileA((folder + "\\" + found.cFileName).c_str());
+	} while (FindNextFileA(search, &found));
+	FindClose(search);
+}
+
+static void removeFrame(const char* name)
+{
+	DeleteFileA(name);
+}
+
+static bool writeFrame(const char* name, const IWindowSurface* surface, size_t size)
+{
+	static std::vector<uint8_t> pixels;
+	pixels.resize(size);
+	packFrame(surface, pixels.data());
+
+	// Temporary, so it stays in memory for the moment it lives
+	const HANDLE file = CreateFileA(name, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL,
+	                                CREATE_ALWAYS, FILE_ATTRIBUTE_TEMPORARY, NULL);
+	if (file == INVALID_HANDLE_VALUE)
+		return false;
+	DWORD written = 0;
+	const bool isWritten = WriteFile(file, pixels.data(), (DWORD)size, &written, NULL) && written == size;
+	CloseHandle(file);
+	if (!isWritten)
+		DeleteFileA(name);
+	return isWritten;
+}
+
+#else
+
+static const char* FRAME_SUFFIX = "";
+
+static void prepareFrames(const char* prefix) {}
+
+static void removeFrame(const char* name)
+{
+	shm_unlink(name);
+}
+
+static bool writeFrame(const char* name, const IWindowSurface* surface, size_t size)
+{
+	const int fd = shm_open(name, O_CREAT | O_EXCL | O_RDWR, 0600);
+	if (fd < 0)
+		return false;
+	if (ftruncate(fd, size) != 0)
+	{
+		close(fd);
+		shm_unlink(name);
+		return false;
+	}
+	uint8_t* out = (uint8_t*)mmap(nullptr, size, PROT_WRITE, MAP_SHARED, fd, 0);
+	close(fd);
+	if (out == MAP_FAILED)
+	{
+		shm_unlink(name);
+		return false;
+	}
+	packFrame(surface, out);
+	munmap(out, size);
+	return true;
+}
+
+#endif
+
+static void frameName(char* out, size_t size, const char* prefix, unsigned frame)
+{
+	snprintf(out, size, "%s%u%s", prefix, frame, FRAME_SUFFIX);
+}
+
+void I_ExportFrame(const IWindowSurface* surface)
+{
+	static const char* prefix = getenv("INTERMISSION_FRAMES");
+	static unsigned frame = 0;
+	// Nobody sees frames while the person is handed back to Claude
+	if (!prefix || !I_IsPlaying() || surface->getBitsPerPixel() != 32)
+		return;
+	if (frame == 0)
+		prepareFrames(prefix);
+
+	// Room for a Windows path as well as a shared-memory name
+	char name[1024];
+	if (frame >= FRAMES_IN_FLIGHT)
+	{
+		frameName(name, sizeof(name), prefix, frame - FRAMES_IN_FLIGHT);
+		removeFrame(name);
+	}
+	frameName(name, sizeof(name), prefix, frame++);
+
+	const int width = surface->getWidth();
+	const int height = surface->getHeight();
+	if (!writeFrame(name, surface, (size_t)width * height * 3))
+		return;
+
+	printf("@frame %s %d %d\n", name, width, height);
+	reportConnected();
+	reportScore();
+	fflush(stdout);
+}
